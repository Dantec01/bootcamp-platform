# Contraseña del único administrador. Nunca la incluyas en el HTML ni en Git.
ADMIN_PASSWORD=elige-una-contrasena-larga
# Cadena aleatoria larga para firmar la sesión (32+ caracteres).
SESSION_SECRET=reemplaza-por-una-cadena-aleatoria-larga
# ID de la carpeta raíz de Google Drive compartida con el email de la cuenta de servicio.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# JSON completo de la clave de la cuenta de servicio de Google, en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
# Solo para desarrollo local: ruta absoluta al JSON descargado. No usar en Vercel.
# GOOGLE_SERVICE_ACCOUNT_JSON_FILE=C:/ruta/a/cuenta-de-servicio.json
# Para una carpeta de Google Drive personal (Gmail), usar OAuth en lugar de la cuenta de servicio.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=
# GOOGLE_OAUTH_REDIRECT_URI=https://developers.google.com/oauthplayground
